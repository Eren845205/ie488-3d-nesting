{
  "_comment": "Lokal Ollama konfig — http://localhost:11434/v1, model llama3:latest. A13 on-prem senaryosu. Webapp bu konfigi yukler; Ollama kapali/dosya yoksa LLM bolumlerini gizler (uygulama COKmez).",
  "providers": {
    "local": {
      "type": "openai_compat",
      "base_url": "http://localhost:11434",
      "timeout_s": 120.0
    },
    "fake": {
      "type": "fake",
      "timeout_s": 1.0
    }
  },
  "roles": {
    "parser": {
      "provider": "local",
      "model": "qwen2.5:3b",
      "temperature": 0.0,
      "max_tokens": 1024,
      "schema_retry": 2,
      "payload_logging": "none"
    },
    "report": {
      "provider": "local",
      "model": "qwen2.5:3b",
      "temperature": 0.0,
      "max_tokens": 1024,
      "schema_retry": 2,
      "payload_logging": "none"
    },
    "assistant": {
      "provider": "local",
      "model": "llama3.2:3b",
      "temperature": 0.1,
      "max_tokens": 1024,
      "schema_retry": 2,
      "payload_logging": "none"
    },
    "teklif": {
      "provider": "local",
      "model": "qwen2.5:3b",
      "temperature": 0.1,
      "max_tokens": 1280,
      "schema_retry": 2,
      "payload_logging": "none"
    },
    "kisit": {
      "provider": "local",
      "model": "qwen2.5:3b",
      "temperature": 0.0,
      "max_tokens": 1024,
      "schema_retry": 2,
      "payload_logging": "none"
    },
    "kisit_hakem": {
      "provider": "local",
      "model": "qwen2.5:7b-instruct",
      "temperature": 0.0,
      "max_tokens": 1024,
      "schema_retry": 2,
      "payload_logging": "none"
    }
  },
  "kisit_modu": "kapali",
  "audit": {
    "log_dir": "logs/llm",
    "payload_log_dir": "logs/llm/payload",
    "payload_logging_default": "none",
    "payload_retention_days": 30
  }
}
