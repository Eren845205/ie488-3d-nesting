{
  "_comment": "UYARI: 'anthropic' provider'i kullanan roller (parser, tuner, hypothesis, assistant, report) calistirilmadan once ANTHROPIC_API_KEY ortam degiskeninin set edilmesi gereklidir. Bu degisken bos kalirsa AnthropicProvider EnvironmentError firlatir.",
  "providers": {
    "anthropic": {
      "type": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "timeout_s": 30.0,
      "rate_limit": {"requests_per_minute": 50}
    },
    "local": {
      "type": "openai_compat",
      "base_url": "http://localhost:11434",
      "timeout_s": 60.0
    },
    "fake": {
      "type": "fake",
      "timeout_s": 1.0
    }
  },
  "roles": {
    "parser": {
      "provider": "anthropic",
      "model": "claude-haiku-20240307",
      "temperature": 0.0,
      "max_tokens": 2048,
      "schema_retry": 2,
      "payload_logging": "redacted"
    },
    "tuner": {
      "provider": "anthropic",
      "model": "claude-haiku-20240307",
      "temperature": 0.0,
      "max_tokens": 512,
      "schema_retry": 2
    },
    "hypothesis": {
      "provider": "anthropic",
      "model": "claude-opus-20240229",
      "temperature": 0.3,
      "max_tokens": 4096,
      "schema_retry": 1
    },
    "assistant": {
      "provider": "anthropic",
      "model": "claude-sonnet-20240229",
      "temperature": 0.1,
      "max_tokens": 2048,
      "schema_retry": 2,
      "payload_logging": "redacted"
    },
    "report": {
      "provider": "anthropic",
      "model": "claude-haiku-20240307",
      "temperature": 0.0,
      "max_tokens": 4096,
      "schema_retry": 2
    }
  },
  "audit": {
    "log_dir": "logs/llm",
    "payload_log_dir": "logs/llm/payload",
    "payload_logging_default": "redacted",
    "payload_retention_days": 30
  }
}
